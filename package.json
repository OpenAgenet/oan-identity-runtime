{
  "name": "@openagenet/oan-identity-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13"
  },
  "description": "Local OAN identity runtime and controlled signing framework.",
  "exports": {
    "./store/sqlite": {
      "types": "./dist/store/sqlite.d.ts",
      "default": "./dist/store/sqlite.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "oan-identity-runtime": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "runtime-host": "node dist/host/serve.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/cli.js",
    "test:lab": "npm run build && node --test test-cases/lab/*.test.mjs"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@openagenet/oan-sdk-ts": "file:../oan-sdk-ts",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
